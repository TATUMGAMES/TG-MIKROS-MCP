{
  "version": "2026-03-09",
  "transport": {
    "httpMcpEndpoint": "/mcp",
    "healthEndpoint": "/mcp/health",
    "authCallbackEndpoint": "/mcp/auth/callback",
    "apiProject": "TG-API-MIKROS",
    "environments": {
      "local": {
        "mcpUrl": "http://localhost/TG-API-MIKROS/index.php/mcp",
        "apiBaseUrl": "http://localhost/TG-API-MIKROS/index.php",
        "websiteBaseUrl": "http://localhost/TG-MIKROS-WEBSITE",
        "authCallbackUrl": "http://localhost/TG-API-MIKROS/index.php/mcp/auth/callback"
      },
      "staging": {
        "mcpUrl": "https://tg-api-new-stage.uc.r.appspot.com/mcp",
        "apiBaseUrl": "https://tg-api-new-stage.uc.r.appspot.com",
        "websiteBaseUrl": "https://stage-developer.tatumgames.com",
        "authCallbackUrl": "https://tg-api-new-stage.uc.r.appspot.com/mcp/auth/callback"
      },
      "production": {
        "mcpUrl": "https://tg-api-new.uc.r.appspot.com/mcp",
        "apiBaseUrl": "https://tg-api-new.uc.r.appspot.com",
        "websiteBaseUrl": "https://developer.tatumgames.com",
        "authCallbackUrl": "https://tg-api-new.uc.r.appspot.com/mcp/auth/callback"
      }
    },
    "websiteAuthPaths": {
      "login": "/mcp/login",
      "signup": "/mcp/signup",
      "verify": "/mcp/verify/{token}",
      "forgotPassword": "/mcp/forgot-password",
      "resetPassword": "/mcp/reset-password/{token}",
      "success": "/mcp/success"
    },
    "registrySource": "application/libraries/McpToolRegistry.php",
    "eventKnowledgeLibrary": "application/config/mcp_event_knowledge.json"
  },
  "tools": [
    {
      "name": "mikros_get_login_url",
      "requiresAuth": false,
      "category": "auth",
      "description": "Get browser authorization URL for MCP access."
    },
    {
      "name": "mikros_signin",
      "requiresAuth": false,
      "category": "auth",
      "description": "Fallback email/password sign-in."
    },
    {
      "name": "mikros_signup",
      "requiresAuth": false,
      "category": "auth",
      "description": "Create MIKROS account (verification email sent)."
    },
    {
      "name": "mikros_logout",
      "requiresAuth": true,
      "category": "auth",
      "description": "Sign out and clear MCP session.",
      "implementedInNodeServer": true
    },
    {
      "name": "complete_profile_onboarding",
