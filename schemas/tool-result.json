{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TATUMGAMES/TG-MIKROS-MCP/schemas/tool-result.json",
  "title": "MIKROS API Tool Result",
  "description": "Common wrapper shape for MIKROS API responses consumed by MCP tools.",
  "type": "object",
  "properties": {
    "status": {
      "type": "object",
      "properties": {
        "statusCode": { "type": "integer" },
        "statusMessage": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "description": "Tool-specific payload."
    }
  }
}
