{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TATUMGAMES/TG-MIKROS-MCP/schemas/campaign-details-required.json",
  "title": "Campaign Details Required",
  "description": "Returned when create_campaign needs more fields.",
  "type": "object",
  "required": ["code", "missing"],
  "properties": {
    "code": {
      "type": "string",
      "const": "CAMPAIGN_DETAILS_REQUIRED"
    },
    "missing": {
      "type": "array",
      "items": { "type": "string" }
    },
    "projects": {
      "type": "array",
      "description": "User projects available for campaign targeting."
    },
    "durations": {
      "type": "array",
      "items": { "type": "string" },
      "example": ["30", "60", "90"]
    },
    "message": { "type": "string" }
  }
}
