{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TATUMGAMES/TG-MIKROS-MCP/schemas/options-required.json",
  "title": "Project Create Options Required",
  "description": "Returned when create_project needs catalog selections from the user.",
  "type": "object",
  "required": ["code", "gameGenres", "gameplayTypes"],
  "properties": {
    "code": {
      "type": "string",
      "enum": ["OPTIONS_REQUIRED", "INVALID_OPTION"]
    },
    "message": {
      "type": "string"
    },
    "gameGenres": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    },
    "gameplayTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    },
    "missing": {
      "type": "object",
      "properties": {
        "appName": { "type": "boolean" },
        "gameGenre": { "type": "boolean" },
        "gameplayType": { "type": "boolean" }
      }
    }
  }
}
